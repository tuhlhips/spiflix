# Port the server listens on
PORT=3000

# Comma-separated list of allowed hostnames (leave empty to allow all)
ALLOWED_HOSTS=

# Hostname the server binds to
HOST=0.0.0.0

# Number of hops to trust for X-Forwarded-For (set to 1 if behind 1 proxy)
TRUST_PROXY=0

# TMDB API key — get one at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Set to "true" to run the UI without a backend (uses TMDB directly)
VITE_STANDALONE=false

# Base URL for the OMSS API
VITE_OMSS_API_URL=http://localhost:4000

# Base URL for the internal API (used by api.ts)
VITE_API_URL=http://localhost:3000

# Backend-only secrets (place these in packages/core/.env; never expose them as VITE_ variables)
# Use a random value, e.g. `openssl rand -base64 48`.
PROXY_SIGNING_SECRET=replace_with_a_long_random_secret

# Optional comma-separated hostname allowlist for stream/CDN hosts. Leave empty
# only while discovering provider hosts; set this in production.
PROXY_ALLOWED_HOSTS=
PROXY_TOKEN_TTL_SECONDS=14400
