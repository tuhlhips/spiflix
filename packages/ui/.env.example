# Port the server listens on
PORT=3000

# Comma-separated list of allowed hostnames (leave empty to allow all)
ALLOWED_HOSTS=

# Hostname the server binds to
HOST=0.0.0.0

# Number of hops to trust for X-Forwarded-For (set to 1 if behind 1 proxy)
TRUST_PROXY=0

# TMDB API key — get one at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Set to "true" to run the UI without a backend (uses TMDB directly)
VITE_STANDALONE=false

# Base URL for the OMSS API
VITE_OMSS_API_URL=http://localhost:4000

# Base URL for the internal API (used by api.ts)
VITE_API_URL=http://localhost:3000
