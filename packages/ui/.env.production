# Baked into the production bundle at build time by Vite.
#
# Without this, VITE_API_URL resolves to '' and every API call goes to the Pages
# origin itself, where the /* -> /index.html SPA rule answers 200 with HTML. The
# app then parses HTML as JSON and every rail silently renders empty — the site
# looks up but has no content. Committed rather than left to a local-only .env
# so a build on a fresh checkout can't lose it.
VITE_API_URL=https://api.spiflix.online
