{
  "name": "spiflix-core",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "cd ../.. && pnpm --filter @spiflix/shared build && pnpm --filter @spiflix/core build"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "CACHE_TYPE": "memory"
  }
}
