{
  "name": "spiflix-core",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "cd ../.. && pnpm --filter @spiflix/shared build && pnpm --filter @spiflix/core build"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "CACHE_TYPE": "memory",
    "PROXY_ALLOWED_HOSTS": "vixsrc.to,vix-content.net,vsembed.ru,cloudnestra.com,neonhorizonworkshops.com,wanderlynest.com,orchidpixelgardens.com",
    "CORS_ORIGIN": "*",
    "PUBLIC_URL": "https://api.spiflix.online"
  }
}
