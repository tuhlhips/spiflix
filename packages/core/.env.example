# Required server credential for TMDB metadata requests.
TMDB_API_KEY=replace_with_your_tmdb_api_key

# Required, independent secret for short-lived signed streaming proxy URLs.
# Generate with: openssl rand -base64 48
PROXY_SIGNING_SECRET=replace_with_a_long_random_secret
PROXY_TOKEN_TTL_SECONDS=14400

# Required in production: comma-separated stream/CDN hostname allowlist.
PROXY_ALLOWED_HOSTS=stream.example.com

PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:3000
